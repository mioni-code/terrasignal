# Copy to .env and fill in. Never commit the real .env file.
# Optional: Gemini powers image interpretation and AI-written reports.
# The rest of TerraSignal works without it.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional: override the SQLite database location
# TERRASIGNAL_DB=./data/terrasignal.db
